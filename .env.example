# IncidentOS Core Configuration
PROJECT_NAME="IncidentOS — Memory-First Incident Response Agent"
PORT=8000

# Hindsight Agent Memory Service
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=dev-key
HINDSIGHT_BANK_ID=incidentos_bank

# RocketRide Agent Orchestration Server
ROCKETRIDE_BASE_URL=http://localhost:5565
ROCKETRIDE_API_KEY=dev-key

# HydraDB Graph Knowledge Base
HYDRADB_URL=http://localhost:9090
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default

# LLM Credentials (Optional)
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
